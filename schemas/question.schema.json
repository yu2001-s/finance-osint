{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.schema.json",
  "title": "Question",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "question",
    "entities",
    "proof_type",
    "priority",
    "submitted_by"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "question" },
    "id": { "type": "string", "pattern": "^question:[A-Za-z0-9_.:-]+$" },
    "question": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^entity:[A-Za-z0-9_.:-]+$" }
    },
    "proof_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "priority": { "type": "string", "enum": ["low", "medium", "high"] },
    "related_evidence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" },
      "default": []
    },
    "related_claims": {
      "type": "array",
      "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9_.:-]+$" },
      "default": []
    },
    "related_relationships": {
      "type": "array",
      "items": { "type": "string", "pattern": "^relationship:[A-Za-z0-9_.:-]+$" },
      "default": []
    },
    "related_theses": {
      "type": "array",
      "items": { "type": "string", "pattern": "^thesis:[A-Za-z0-9_.:-]+$" },
      "default": []
    },
    "next_actions": { "type": "array", "items": { "type": "string" }, "default": [] },
    "resolved_by": { "type": "array", "items": { "type": "string" }, "default": [] },
    "submitted_by": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "created_at": { "type": "string" },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "supersedes": { "type": "array", "items": { "type": "string" }, "default": [] },
    "superseded_by": { "type": "string" },
    "duplicate_of": { "type": "string" },
    "archive_reason": { "type": "string" }
  },
  "additionalProperties": true
}
