{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation.schema.json",
  "title": "Validation",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "target",
    "submitted_by",
    "verdict",
    "summary",
    "depends_on"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "validation" },
    "id": { "type": "string", "pattern": "^validation:[A-Za-z0-9_.:-]+$" },
    "target": {
      "type": "string",
      "pattern": "^(evidence|claim|relationship|thesis|metric|event|dataset):[A-Za-z0-9_.:-]+$"
    },
    "submitted_by": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "verdict": {
      "type": "string",
      "enum": [
        "attests",
        "supports",
        "partially_supports",
        "disputes",
        "falsifies",
        "marks_stale",
        "withdraws"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "depends_on": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" }
        },
        "claims": {
          "type": "array",
          "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9_.:-]+$" }
        },
        "relationships": {
          "type": "array",
          "items": { "type": "string", "pattern": "^relationship:[A-Za-z0-9_.:-]+$" }
        },
        "theses": {
          "type": "array",
          "items": { "type": "string", "pattern": "^thesis:[A-Za-z0-9_.:-]+$" }
        },
        "metrics": {
          "type": "array",
          "items": { "type": "string", "pattern": "^metric:[A-Za-z0-9_.:-]+$" }
        },
        "events": {
          "type": "array",
          "items": { "type": "string", "pattern": "^event:[A-Za-z0-9_.:-]+$" }
        }
      },
      "additionalProperties": true
    },
    "created_at": { "type": "string" },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "withdraws": { "type": "string" }
  },
  "additionalProperties": true
}
