{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Claim",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "statement",
    "subject",
    "predicate",
    "support_type",
    "evidence",
    "submitted_by"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "claim" },
    "id": { "type": "string", "pattern": "^claim:[A-Za-z0-9_.:-]+$" },
    "statement": { "type": "string", "minLength": 1 },
    "subject": { "type": "string" },
    "predicate": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_]*|provisional:[a-z][a-z0-9_]*)$"
    },
    "proposed_predicate_definition": { "type": "string" },
    "object": { "type": ["string", "number", "boolean", "null"] },
    "qualifiers": { "type": "object", "additionalProperties": true },
    "time_scope": {
      "type": "object",
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "period": { "type": "object", "additionalProperties": true },
    "as_of": { "type": "string" },
    "support_type": {
      "type": "string",
      "enum": ["direct", "observed", "inferred", "private_attestation", "rumor"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" },
              "support_type": {
                "type": "string",
                "enum": ["direct", "observed", "inferred", "private_attestation", "rumor"]
              },
              "locator": { "type": "object", "additionalProperties": true },
              "methodology": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "methodology": { "type": "string" },
    "submitted_by": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "created_at": { "type": "string" },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "contradicts": { "type": "array", "items": { "type": "string" }, "default": [] },
    "supersedes": { "type": "array", "items": { "type": "string" }, "default": [] },
    "superseded_by": { "type": "string" },
    "duplicate_of": { "type": "string" },
    "corrects": { "type": "array", "items": { "type": "string" }, "default": [] },
    "restates": { "type": "array", "items": { "type": "string" }, "default": [] },
    "narrows": { "type": "array", "items": { "type": "string" }, "default": [] },
    "broadens": { "type": "array", "items": { "type": "string" }, "default": [] },
    "withdrawn_by": { "type": "string" }
  },
  "additionalProperties": true
}
