{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Claim",
  "type": "object",
  "required": ["kind", "id", "statement", "subject", "predicate", "status", "confidence", "evidence"],
  "properties": {
    "kind": { "const": "claim" },
    "id": { "type": "string", "pattern": "^claim:[A-Za-z0-9_.:-]+$" },
    "statement": { "type": "string", "minLength": 1 },
    "subject": { "type": "string" },
    "predicate": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "object": { "type": ["string", "number", "boolean", "null"] },
    "qualifiers": { "type": "object", "additionalProperties": true },
    "time_scope": {
      "type": "object",
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "status": { "type": "string", "enum": ["proposed", "corroborated", "disputed", "falsified", "superseded", "stale"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" }
    },
    "submitted_by": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "created_at": { "type": "string" },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "default": [] }
  },
  "additionalProperties": true
}

