{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity.schema.json",
  "title": "Entity",
  "type": "object",
  "required": ["schema_version", "kind", "id", "entity_type", "name"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "entity" },
    "id": { "type": "string", "pattern": "^entity:[a-z_]+:[a-z0-9_.-]+$" },
    "entity_type": {
      "type": "string",
      "enum": [
        "company",
        "person",
        "product",
        "component",
        "security",
        "listing",
        "market",
        "geography",
        "architecture",
        "commodity",
        "technology",
        "regulation",
        "fund",
        "service"
      ]
    },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" }, "default": [] },
    "identifiers": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "array", "null"] }
    },
    "description": { "type": "string" },
    "state": {
      "type": "string",
      "enum": ["active", "inactive", "proposed", "merged", "retired"]
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
