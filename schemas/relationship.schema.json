{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relationship.schema.json",
  "title": "Relationship",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "type",
    "participants",
    "derived_from",
    "submitted_by"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "relationship" },
    "id": { "type": "string", "pattern": "^relationship:[A-Za-z0-9_.:-]+$" },
    "type": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_]*|provisional:[a-z][a-z0-9_]*)$"
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "entity"],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "entity": { "type": "string", "pattern": "^entity:[A-Za-z0-9_.:-]+$" }
        },
        "additionalProperties": true
      }
    },
    "scope": { "type": "object", "additionalProperties": true },
    "direction": { "type": "object", "additionalProperties": true },
    "time_scope": {
      "type": "object",
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "effective_at": { "type": "string" },
    "materiality": {
      "type": "object",
      "properties": {
        "level": { "type": "string" },
        "basis": { "type": "string", "enum": ["observed", "inferred", "estimated", "unknown"] }
      },
      "additionalProperties": true
    },
    "derived_from": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9_.:-]+$" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" }
        },
        "metrics": {
          "type": "array",
          "items": { "type": "string", "pattern": "^metric:[A-Za-z0-9_.:-]+$" }
        },
        "events": {
          "type": "array",
          "items": { "type": "string", "pattern": "^event:[A-Za-z0-9_.:-]+$" }
        }
      },
      "additionalProperties": true
    },
    "proposed_type_definition": { "type": "string" },
    "submitted_by": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "created_at": { "type": "string" },
    "contradicts": { "type": "array", "items": { "type": "string" }, "default": [] },
    "supersedes": { "type": "array", "items": { "type": "string" }, "default": [] },
    "superseded_by": { "type": "string" },
    "duplicate_of": { "type": "string" },
    "corrects": { "type": "array", "items": { "type": "string" }, "default": [] },
    "restates": { "type": "array", "items": { "type": "string" }, "default": [] },
    "narrows": { "type": "array", "items": { "type": "string" }, "default": [] },
    "broadens": { "type": "array", "items": { "type": "string" }, "default": [] },
    "withdrawn_by": { "type": "string" }
  },
  "additionalProperties": true
}
