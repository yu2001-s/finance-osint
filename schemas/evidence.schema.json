{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "evidence_class",
    "source",
    "summary",
    "content_mode",
    "submitted_by",
    "observed_at",
    "source_attribution"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "evidence" },
    "id": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" },
    "evidence_class": {
      "type": "string",
      "enum": [
        "public_primary",
        "public_secondary",
        "firsthand_public",
        "firsthand_private",
        "anonymous_internal",
        "rumor"
      ]
    },
    "source": { "type": "string", "pattern": "^source:[A-Za-z0-9_.:-]+$" },
    "summary": { "type": "string", "minLength": 1 },
    "content_mode": {
      "type": "string",
      "enum": [
        "metadata_only",
        "excerpt",
        "summary",
        "redacted_summary",
        "small_fixture",
        "external_link"
      ]
    },
    "excerpt": { "type": "string" },
    "locator": {
      "type": "object",
      "properties": {
        "page": { "type": ["integer", "string"] },
        "section": { "type": "string" },
        "table": { "type": "string" },
        "timestamp": { "type": "string" },
        "row": { "type": ["integer", "string"] },
        "column": { "type": "string" }
      },
      "additionalProperties": true
    },
    "observed_at": { "type": "string" },
    "submitted_by": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "source_attribution": {
      "type": "string",
      "enum": ["named_public", "anonymous_to_public", "unknown"]
    },
    "source_access": {
      "type": "object",
      "properties": {
        "nda_or_confidentiality": { "type": ["boolean", "string"] },
        "recording_available": { "type": ["boolean", "string"] },
        "source_identity_public": { "type": ["boolean", "string"] }
      },
      "additionalProperties": true
    },
    "verification_status": { "type": "string" },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "default": [] }
  },
  "additionalProperties": true
}
