{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge.schema.json",
  "title": "Challenge",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "target",
    "submitted_by",
    "challenge_type",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "challenge" },
    "id": { "type": "string", "pattern": "^challenge:[A-Za-z0-9_.:-]+$" },
    "target": {
      "type": "string",
      "pattern": "^(evidence|claim|relationship|thesis|metric|event|dataset):[A-Za-z0-9_.:-]+$"
    },
    "submitted_by": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "challenge_type": {
      "type": "string",
      "enum": [
        "contradiction",
        "missing_evidence",
        "source_quality",
        "scope_error",
        "outdated",
        "ontology_issue",
        "materiality_dispute",
        "other"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "depends_on": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" }
        },
        "claims": {
          "type": "array",
          "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9_.:-]+$" }
        },
        "relationships": {
          "type": "array",
          "items": { "type": "string", "pattern": "^relationship:[A-Za-z0-9_.:-]+$" }
        },
        "theses": {
          "type": "array",
          "items": { "type": "string", "pattern": "^thesis:[A-Za-z0-9_.:-]+$" }
        },
        "metrics": {
          "type": "array",
          "items": { "type": "string", "pattern": "^metric:[A-Za-z0-9_.:-]+$" }
        },
        "events": {
          "type": "array",
          "items": { "type": "string", "pattern": "^event:[A-Za-z0-9_.:-]+$" }
        }
      },
      "additionalProperties": true
    },
    "created_at": { "type": "string" },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "addressed_by": { "type": "string" },
    "withdrawn_by": { "type": "string" },
    "superseded_by": { "type": "string" }
  },
  "additionalProperties": true
}
