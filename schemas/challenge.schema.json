{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge.schema.json",
  "title": "Challenge",
  "type": "object",
  "required": ["kind", "id", "target", "author", "challenge_type", "summary", "status"],
  "properties": {
    "kind": { "const": "challenge" },
    "id": { "type": "string", "pattern": "^challenge:[A-Za-z0-9_.:-]+$" },
    "target": {
      "type": "string",
      "pattern": "^(evidence|claim|rel|thesis|arg|debate|resolution):[A-Za-z0-9_.:-]+$"
    },
    "author": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "challenge_type": {
      "type": "string",
      "enum": [
        "contradiction",
        "missing_evidence",
        "source_quality",
        "scope_error",
        "outdated",
        "ontology_issue",
        "materiality_dispute",
        "legal_or_confidentiality_risk",
        "other"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "depends_on": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" }
        },
        "claims": {
          "type": "array",
          "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9_.:-]+$" }
        },
        "relationships": {
          "type": "array",
          "items": { "type": "string", "pattern": "^rel:[A-Za-z0-9_.:-]+$" }
        },
        "theses": {
          "type": "array",
          "items": { "type": "string", "pattern": "^thesis:[A-Za-z0-9_.:-]+$" }
        },
        "arguments": {
          "type": "array",
          "items": { "type": "string", "pattern": "^arg:[A-Za-z0-9_.:-]+$" }
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": ["open", "addressed", "rejected", "withdrawn", "superseded"]
    },
    "created_at": { "type": "string" },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "default": [] }
  },
  "additionalProperties": true
}

