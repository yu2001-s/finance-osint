{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metric.schema.json",
  "title": "Metric",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "entity",
    "metric_definition",
    "value",
    "unit",
    "period",
    "value_basis",
    "evidence",
    "submitted_by"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "metric" },
    "id": { "type": "string", "pattern": "^metric:[A-Za-z0-9_.:-]+$" },
    "entity": { "type": "string", "pattern": "^entity:[A-Za-z0-9_.:-]+$" },
    "metric_definition": {
      "type": "string",
      "pattern": "^metric_definition:[a-z][a-z0-9_]*$"
    },
    "value": { "type": "number" },
    "unit": { "type": "string" },
    "period": { "type": "object", "additionalProperties": true },
    "value_basis": {
      "type": "string",
      "enum": ["reported", "observed", "derived", "estimated", "restated"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" }
    },
    "source_locator": { "type": "object", "additionalProperties": true },
    "as_of": { "type": "string" },
    "reported_at": { "type": "string" },
    "published_at": { "type": "string" },
    "restated_from": { "type": "string" },
    "dimensions": { "type": "object", "additionalProperties": true },
    "methodology": { "type": "string" },
    "limitations": { "type": "string" },
    "submitted_by": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": true
}
