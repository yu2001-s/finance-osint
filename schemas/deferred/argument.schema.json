{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "argument.schema.json",
  "title": "Argument",
  "type": "object",
  "required": ["kind", "id", "debate", "author", "stance", "summary", "depends_on"],
  "properties": {
    "kind": { "const": "argument" },
    "id": { "type": "string", "pattern": "^arg:[A-Za-z0-9_.:-]+$" },
    "debate": { "type": "string", "pattern": "^debate:[A-Za-z0-9_.:-]+$" },
    "author": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "position": { "type": "string" },
    "stance": { "type": "string", "enum": ["supports", "opposes", "rebuts", "qualifies", "asks_for_evidence"] },
    "target": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "depends_on": {
      "type": "object",
      "properties": {
        "evidence": { "type": "array", "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" } },
        "claims": { "type": "array", "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9_.:-]+$" } },
        "relationships": { "type": "array", "items": { "type": "string", "pattern": "^rel:[A-Za-z0-9_.:-]+$" } },
        "theses": { "type": "array", "items": { "type": "string", "pattern": "^thesis:[A-Za-z0-9_.:-]+$" } }
      },
      "additionalProperties": true
    },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "created_at": { "type": "string" }
  },
  "additionalProperties": true
}
