{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Source",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "source_type",
    "title",
    "public_status",
    "accessed_at",
    "content_mode"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "source" },
    "id": { "type": "string", "pattern": "^source:[A-Za-z0-9_.:-]+$" },
    "source_type": {
      "type": "string",
      "enum": [
        "sec_filing",
        "transcript",
        "press_release",
        "court_document",
        "official_dataset",
        "company_report",
        "product_page",
        "market_data_page",
        "web_page",
        "news_article",
        "social_media_post",
        "research_report",
        "conference",
        "meeting",
        "field_observation",
        "anonymous_report",
        "internal_report",
        "other"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string" },
    "url": { "type": "string" },
    "archive_url": { "type": "string" },
    "published_at": { "type": "string" },
    "accessed_at": { "type": "string" },
    "public_status": { "type": "string", "enum": ["public", "nonpublic", "unknown"] },
    "source_perspective": {
      "type": "string",
      "enum": [
        "company_self",
        "counterparty_self",
        "independent_media",
        "independent_research",
        "government_or_regulator",
        "court_or_legal_record",
        "social_media_author",
        "firsthand_observer",
        "anonymous_source",
        "internal_source",
        "aggregator",
        "synthetic_fixture",
        "unknown"
      ]
    },
    "content_mode": {
      "type": "string",
      "enum": [
        "metadata_only",
        "excerpt",
        "summary",
        "redacted_summary",
        "small_fixture",
        "external_link"
      ]
    },
    "provenance": { "type": "string" },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^artifacts/sources/[A-Za-z0-9_.:/-]+\\.(png|jpg|jpeg|pdf)$"
      },
      "default": []
    },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "accession_number": { "type": "string" },
    "form_type": { "type": "string" },
    "filing_date": { "type": "string" },
    "accepted_at": { "type": "string" },
    "period_of_report": { "type": "string" },
    "amends": { "type": ["string", "null"] },
    "content_hash": { "type": "string" }
  },
  "additionalProperties": true
}
