{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thesis.schema.json",
  "title": "Thesis",
  "type": "object",
  "required": ["kind", "id", "title", "summary", "status", "confidence", "depends_on", "author"],
  "properties": {
    "kind": { "const": "thesis" },
    "id": { "type": "string", "pattern": "^thesis:[A-Za-z0-9_.:-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "stance": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "under_review", "supported", "contested", "weakened", "superseded", "retired"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "time_horizon": { "type": "string" },
    "depends_on": {
      "type": "object",
      "properties": {
        "evidence": { "type": "array", "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" } },
        "claims": { "type": "array", "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9_.:-]+$" } },
        "relationships": { "type": "array", "items": { "type": "string", "pattern": "^rel:[A-Za-z0-9_.:-]+$" } }
      },
      "additionalProperties": true
    },
    "contradicting_evidence": { "type": "array", "items": { "type": "string" }, "default": [] },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "author": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": true
}

