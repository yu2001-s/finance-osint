{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thesis.schema.json",
  "title": "Thesis",
  "type": "object",
  "required": ["schema_version", "kind", "id", "title", "summary", "depends_on", "submitted_by"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "thesis" },
    "id": { "type": "string", "pattern": "^thesis:[A-Za-z0-9_.:-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "stance": { "type": "string" },
    "time_horizon": { "type": "string" },
    "depends_on": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": { "type": "string", "pattern": "^evidence:[A-Za-z0-9_.:-]+$" }
        },
        "claims": {
          "type": "array",
          "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9_.:-]+$" }
        },
        "relationships": {
          "type": "array",
          "items": { "type": "string", "pattern": "^relationship:[A-Za-z0-9_.:-]+$" }
        },
        "metrics": {
          "type": "array",
          "items": { "type": "string", "pattern": "^metric:[A-Za-z0-9_.:-]+$" }
        },
        "events": {
          "type": "array",
          "items": { "type": "string", "pattern": "^event:[A-Za-z0-9_.:-]+$" }
        },
        "datasets": {
          "type": "array",
          "items": { "type": "string", "pattern": "^dataset:[A-Za-z0-9_.:-]+$" }
        }
      },
      "additionalProperties": true
    },
    "forecast": { "type": "object", "additionalProperties": true },
    "contradicting_evidence": { "type": "array", "items": { "type": "string" }, "default": [] },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "submitted_by": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+$" },
    "created_at": { "type": "string" },
    "contradicts": { "type": "array", "items": { "type": "string" }, "default": [] },
    "supersedes": { "type": "array", "items": { "type": "string" }, "default": [] },
    "superseded_by": { "type": "string" },
    "duplicate_of": { "type": "string" },
    "corrects": { "type": "array", "items": { "type": "string" }, "default": [] },
    "restates": { "type": "array", "items": { "type": "string" }, "default": [] },
    "narrows": { "type": "array", "items": { "type": "string" }, "default": [] },
    "broadens": { "type": "array", "items": { "type": "string" }, "default": [] },
    "withdrawn_by": { "type": "string" }
  },
  "additionalProperties": true
}
